    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    <div class="row">
        <div class="col-md-10">
            <h3 class="display-8">Bank List</h3>
        </div>
        <div class="col-md-2 text-end">
            <button type="button" class="btn btn-primary" onclick="add();">
                Add
            </button>
        </div>
    </div>
        <div class="row">
            <div class="col-md-12">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr class="card-header">
                            <th class="card-title text-center">Name</th>
                            <th class="card-title text-center">UserName</th>
                            <th class="card-title text-center">Password</th>
                            <th class="card-title text-center">Status</th>
                            <th class="card-title text-center">Avatar</th>
                            <th class="card-title text-center">Phone</th>
                            <th class="card-title text-center">StoreName</th>
                            <th class="card-title text-center">X</th>
                            <th class="card-title text-center">Y</th>
                            <th class="card-title text-center">Address</th>
                            <th class="card-title text-center">Description</th>
                            <th class="card-title text-center"></th>
                        </tr>
                    </thead>
                    <tbody class="Members">
                    </tbody>
                </table>
            </div>
        </div>

}
@section scripts {
    <script type="text/javascript">
        $(document).ready(function (){
            loadData();
        });


        function loadData() { alert("Load data progressing..."); }
        $.ajax({
            url: 'https://localhost:7194/member',
            type: "GET",
            contentType: "application/json;charset=utf-8",
            dataType: "json",
            success: function (result) {
                alert('Server response: ' + result.message);
                console.log(result);
                var html = '';
                $.each(result.data, function (key, item) {
                    html += '<tr>';
                    html += '<td>' + item.name + '</td>';
                    html += '<td>' + item.userName + '</td>';
                    html += '<td>' + item.password + '</td>';
                    html += '<td>' + item.status + '</td>';
                    html += '<td>' + item.avatar + '</td>';
                    html += '<td>' + item.phone + '</td>';
                    html += '<td>' + item.storeName + '</td>';
                    html += '<td>' + item.x + '</td>';
                    html += '<td>' + item.y + '</td>';
                    html += '<td>' + item.address + '</td>';
                    html += '<td>' + item.description + '</td>';
                    html += '<td></td>';
                    html += '</tr>';
                });
                $('.Members').html(html);
            },
            error: function (xhr, error) {
                alert(xhr.statusText);
            }
        })
        function add() {
            $("#bankModalContent").html("");
            $("#bankModalLabel").html("Add New");

            $('#bankModal').modal('show');
        } 
    </script>
}
<div class="modal fade" id="bankModal" tabindex="-1" aria-labelledby="bankModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm(null, null, FormMethod.Post, new { name = "frm", id = "frm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="bankModalLabel">Bank</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                </div>
                <div class="modal-footer">
                    <button id="btSave" type="button" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            }
        </div>
    </div>
</div>
