@model IEnumerable<FENGSHUIKOI.Data.Models.ProductDetail>

@{
    ViewData["Title"] = "Product Detail List";
}

<div class="row">
    <div class="col-md-10">
        <h3 class="display-8">Product Detail List</h3>
    </div>
    <div class="col-md-2 text-end">
        <button type="button" class="btn btn-primary" onclick="add();">
            Add
        </button>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <table class="table table-striped table-bordered table-hover">
            <thead>
                <tr class="card-header">
                    <th class="card-title text-center">Name</th>
                    <th class="card-title text-center">Description</th>
                    <th class="card-title text-center">Color</th>
                    <th class="card-title text-center">Quantity</th>
                    <th class="card-title text-center">Type</th>
                    <th class="card-title text-center">Size</th>
                    <th class="card-title text-center">Origin</th>
                    <th class="card-title text-center">Status</th>
                    <th class="card-title text-center">Create Date</th>
                    <th class="card-title text-center">TypeId</th>
                    <th class="card-title text-center">ComboId</th>
                </tr>
            </thead>
            <tbody class="tblProductDetail">
            </tbody>
        </table>
    </div>
</div>

<!-- Modal for Adding New Product Detail -->
<div class="modal fade" id="productDetailModal" tabindex="-1" aria-labelledby="productDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("Create", "ProductDetailV2", FormMethod.Post, new { name = "frm", id = "frm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="productDetailModalLabel">Product Detail</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>


                <input type="hidden" class="form-control" id="ProductDetailId" required>
                <div class="modal-body" id="productDetailModalContent">
                    <div class="mb-3">
                        <label for="Name" class="form-label">Name</label>
                        <input type="text" class="form-control" id="Name" name="Name" required>
                    </div>
                    <div class="mb-3">
                        <label for="Description" class="form-label">Description</label>
                        <input type="text" class="form-control" id="Description" name="Description" required>
                    </div>
                    <div class="mb-3">
                        <label for="Color" class="form-label">Color</label>
                        <input type="text" class="form-control" id="Color" name="Color" required>
                    </div>
                    <div class="mb-3">
                        <label for="Type" class="form-label">Type</label>
                        <input type="text" class="form-control" id="Type" name="Type" required>
                    </div>
                    <div class="mb-3">
                        <label for="Quantity" class="form-label">Quantity</label>
                        <input type="number" class="form-control" id="Quantity" name="Quantity" required>
                    </div>
                   
                    <div class="mb-3">
                        <label for="Size" class="form-label">Size</label>
                        <input type="text" class="form-control" id="Size" name="Size" required>
                    </div>
                    <div class="mb-3">
                        <label for="Origin" class="form-label">Origin</label>
                        <input type="text" class="form-control" id="Origin" name="Origin" required>
                    </div>
                    <div class="mb-3">
                        <label for="Status" class="form-label">Status</label>
                        <input type="text" class="form-control" id="Status" name="Status" required>
                    </div>

                     <div class="mb-3">
                        <label for="TypeId" class="form-label">Type</label>
                        <select class="form-select" id="TypeId" name="TypeId" required>
                            <option value="" disabled selected>Select a Type</option>
                            
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="ComboId" class="form-label">Combo</label>
                        <select class="form-select" id="ComboId" name="ComboId" required>
                            <option value="" disabled selected>Select a Type</option>

                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button id="btSave" type="button" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        var typesData = [];
        var comboData = [];

        $(document).ready(function () {
            loadData();
            loadTypeList();
            loadComboList();
        });


        function loadTypeList() {
            $.ajax({
                type: 'GET',
                url: 'https://localhost:7194/api/type',
                success: function (result) {
                    typesData = result.data;
                    $.each(result.data, function (key, item) {
                        $('#TypeId').append(
                            $('<option>', {
                                value: item.id,
                                text: item.name
                            })
                        );
                    });
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching elements:", error);
                }
            });
        }


        function loadComboList() {
            $.ajax({
                type: 'GET',
                url: 'https://localhost:7194/api/Comboes',
                success: function (result) {
                    comboData = result.data;
                    $.each(result.data, function (key, item) {
                        $('#ComboId').append(
                            $('<option>', {
                                value: item.id,
                                text: item.comboName
                            })
                        );
                    });
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching elements:", error);
                }
            });
        }


        function loadData() {
            $.ajax({
                url: 'https://localhost:7194/api/ProductDetail',
                type: "GET",
                contentType: "application/json;charset=utf-8",
                dataType: "json",
                success: function (result) {
                    alert('Server response: ' + result.message);
                    var html = '';

                    var typeMap = {};
                    $.each(typesData, function (key, item) {
                        typeMap[item.id] = item.name;
                    });

                    
                    var comboMap = {};
                    $.each(comboData, function (key, item) {
                        comboMap[item.id] = item.comboName;
                    });


                    $.each(result.data, function (key, item) {
                        html += '<tr>';
                        html += '<td>' + item.name + '</td>';
                        html += '<td>' + item.description + '</td>';
                        html += '<td>' + item.color + '</td>';
                        html += '<td>' + item.quantity + '</td>';
                        html += '<td>' + item.type + '</td>';
                        html += '<td>' + item.size + '</td>';
                        html += '<td>' + item.origin + '</td>';
                        html += '<td>' + item.status + '</td>';
                        html += '<td>' + item.createDate + '</td>';
                        html += '<td>' + typeMap[item.typeId] + '</td>';
                        html += '<td>' + comboMap[item.comboId] + '</td>';
                        html += '</tr>';
                    });
                    $('.tblProductDetail').html(html);


                },
                error: function (xhr, error) {
                    alert(xhr.statusText);
                }
            });
        }

        function add() {
            $("#productDetailModalLabel").html("Add New Product Detail");
            $('#productDetailModal').modal('show');
        }

        $("#btSave").click(function () {
            $.ajax({
                type: 'POST',
                url: 'https://localhost:7194/api/ProductDetail',
                headers: {
                    'Accept': 'text/plain',
                    'Content-type': 'application/json; charset=utf-8'
                },
                data: JSON.stringify({
                    productDetailId: 0, 
                    name: $("#Name").val(),
                    description: $("#Description").val(),
                    color: $("#Color").val(),
                    type: $("#Type").val(),
                    quantity: $("#Quantity").val(),
                    typeId: $("#TypeId").val(),
                    size: $("#Size").val(),
                    origin: $("#Origin").val(),
                    status: $("#Status").val(),
                    createDate: $("#CreateDate").val(),
                    comboId: $("#ComboId").val()
                }),
                success: function (result) {
                    if (result.status >= 1) {
                        $("#productDetailModal").modal('hide');
                        loadData();
                    }
                    alert(result.message);
                },
                error: function (xhr, error) {
                    alert(xhr.responseText);
                    console.log(xhr);
                }
            });
        });

        

    </script>
}
